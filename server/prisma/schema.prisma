generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  BUYER
  ARTIST
  ORGANIZER
  ADMIN
}

enum ModerationStatus {
  PENDING
  APPROVED
  FLAGGED
  REJECTED
}

enum ArtworkAvailability {
  AVAILABLE
  RESERVED
  SOLD
}

enum AuctionStatus {
  UPCOMING
  ACTIVE
  ENDED
  CANCELLED
}

enum TransactionType {
  TOP_UP
  PURCHASE_DEBIT
  SALE_CREDIT
  AUCTION_BID_HOLD
  AUCTION_BID_REFUND
  AUCTION_WIN_PAYOUT
  EXHIBITION_TICKET
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(BUYER)
  bio          String?
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relationships
  wallet             Wallet?
  artworks           Artwork[]            @relation("ArtistArtworks")
  orders             Order[]              @relation("BuyerOrders")
  soldOrders         Order[]              @relation("SellerOrders")
  bids               AuctionBid[]
  exhibitions        Exhibition[]         @relation("OrganizerExhibitions")
  tickets            ExhibitionTicket[]
  reviewedFlags      ModerationReview[]   @relation("AdminReviews")

  @@index([role])
  @@index([email])
}

model Wallet {
  id           String              @id @default(uuid())
  userId       String              @unique
  balance      Decimal             @default(0.0) @db.Decimal(12, 2)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions CreditTransaction[]

  @@index([userId])
}

model CreditTransaction {
  id          String          @id @default(uuid())
  walletId    String
  amount      Decimal         @db.Decimal(12, 2)
  type        TransactionType
  description String
  referenceId String?
  createdAt   DateTime        @default(now())

  wallet      Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([type])
  @@index([referenceId])
}

model Artwork {
  id               String              @id @default(uuid())
  title            String
  description      String
  medium           String
  dimensions       String?
  price            Decimal             @db.Decimal(12, 2)
  imageUrl         String
  imageHash        String?             // 64-bit dHash string
  availability     ArtworkAvailability @default(AVAILABLE)
  moderationStatus ModerationStatus    @default(PENDING)
  artistId         String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  artist           User                @relation("ArtistArtworks", fields: [artistId], references: [id], onDelete: Cascade)
  orders           Order[]
  auctionItems     Auction[]
  exhibitionItems  ExhibitionArtwork[]
  flaggedAsSource  ModerationReview[]  @relation("SourceArtwork")
  flaggedAsMatch   ModerationReview[]  @relation("SuspectedMatchArtwork")

  @@index([artistId])
  @@index([availability])
  @@index([moderationStatus])
  @@index([imageHash])
  @@index([price])
}

model Order {
  id          String   @id @default(uuid())
  buyerId     String
  sellerId    String
  artworkId   String
  amountPaid  Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  buyer       User     @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Restrict)
  seller      User     @relation("SellerOrders", fields: [sellerId], references: [id], onDelete: Restrict)
  artwork     Artwork  @relation(fields: [artworkId], references: [id], onDelete: Restrict)

  @@index([buyerId])
  @@index([sellerId])
  @@index([artworkId])
}

model Auction {
  id              String        @id @default(uuid())
  artworkId       String
  startingBid     Decimal       @db.Decimal(12, 2)
  currentHighestBid Decimal?    @db.Decimal(12, 2)
  minIncrement    Decimal       @default(10.0) @db.Decimal(12, 2)
  startTime       DateTime
  endTime         DateTime
  status          AuctionStatus @default(UPCOMING)
  winnerId        String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  artwork         Artwork       @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  bids            AuctionBid[]

  @@index([status])
  @@index([startTime, endTime])
  @@index([artworkId])
}

model AuctionBid {
  id        String   @id @default(uuid())
  auctionId String
  bidderId  String
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  auction   Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  bidder    User     @relation(fields: [bidderId], references: [id], onDelete: Restrict)

  @@index([auctionId, amount(sort: Desc)])
  @@index([bidderId])
}

model Exhibition {
  id          String              @id @default(uuid())
  title       String
  description String
  bannerUrl   String?
  ticketPrice Decimal             @default(0.0) @db.Decimal(12, 2)
  startTime   DateTime
  endTime     DateTime
  vipStartTime DateTime?
  vipEndTime   DateTime?
  layoutConfig Json?              // Gallery wall placement coordinates
  organizerId String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  organizer   User                @relation("OrganizerExhibitions", fields: [organizerId], references: [id], onDelete: Cascade)
  artworks    ExhibitionArtwork[]
  tickets     ExhibitionTicket[]

  @@index([organizerId])
  @@index([startTime, endTime])
}

model ExhibitionArtwork {
  id           String     @id @default(uuid())
  exhibitionId String
  artworkId    String
  wallPosition Int?
  posX         Float?
  posY         Float?

  exhibition   Exhibition @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  artwork      Artwork    @relation(fields: [artworkId], references: [id], onDelete: Cascade)

  @@unique([exhibitionId, artworkId])
}

model ExhibitionTicket {
  id           String     @id @default(uuid())
  ticketToken  String     @unique // e.g. NK-EXH-2026-X9B2
  exhibitionId String
  buyerId      String
  isVip        Boolean    @default(false)
  purchasedAt  DateTime   @default(now())

  exhibition   Exhibition @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  buyer        User       @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  @@index([ticketToken])
  @@index([buyerId])
  @@index([exhibitionId])
}

model ModerationReview {
  id                    String   @id @default(uuid())
  sourceArtworkId       String
  suspectedMatchId      String?
  similarityScore       Float    // e.g. 87.5
  adminId               String?
  actionTaken           String?  // 'APPROVED', 'REJECTED'
  adminNotes            String?
  createdAt             DateTime @default(now())
  reviewedAt            DateTime?

  sourceArtwork         Artwork  @relation("SourceArtwork", fields: [sourceArtworkId], references: [id], onDelete: Cascade)
  suspectedMatchArtwork Artwork? @relation("SuspectedMatchArtwork", fields: [suspectedMatchId], references: [id], onDelete: SetNull)
  admin                 User?    @relation("AdminReviews", fields: [adminId], references: [id], onDelete: SetNull)

  @@index([sourceArtworkId])
  @@index([suspectedMatchId])
}
